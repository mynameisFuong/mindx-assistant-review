{
  "manifest_version": 3,
  "name": "MindX Review Assistant",
  "version": "0.7.2",
  "description": "Tạo, duyệt, điền và lưu nhận xét học viên, bao gồm form checkpoint trên MindX LMS.",
  "host_permissions": [
    "https://lms.mindx.edu.vn/*",
    "http://127.0.0.1:8787/*"
  ],
  "background": {"service_worker": "backend.js"},
  "content_scripts": [
    {
      "matches": ["https://lms.mindx.edu.vn/*"],
      "js": ["page_bridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://lms.mindx.edu.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
