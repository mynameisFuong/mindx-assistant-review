{
  "manifest_version": 3,
  "name": "MindX Review Assistant",
  "version": "0.6.2",
  "description": "Tạo, duyệt, điền và lưu nhận xét học viên, bao gồm form checkpoint trên MindX LMS.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://lms.mindx.edu.vn/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://lms.mindx.edu.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
